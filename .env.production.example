# Production Environment Variables
# Copy this file to .env.production and fill in the actual values

# Authentication
BETTER_AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-hex-32
BETTER_AUTH_URL="https://your-domain.com"

# Server Configuration
ONE_SERVER_URL="https://your-domain.com"

# Zero Sync Server
VITE_PUBLIC_ZERO_SERVER="https://zero.your-domain.com"

# GitHub OAuth (optional)
# ONECHAT_GITHUB_CLIENT_ID=your-github-client-id
# ONECHAT_GITHUB_CLIENT_SECRET=your-github-client-secret

# Database Connections (Aurora/RDS)
ZERO_UPSTREAM_DB="postgresql://user:password@your-db-host:5432/postgres"
ZERO_CVR_DB="postgresql://user:password@your-db-host:5432/zero_cvr"
ZERO_CHANGE_DB="postgresql://user:password@your-db-host:5432/zero_cdb"
ZERO_AUTH_JWKS_URL="https://your-domain.com/api/auth/jwks"
ZERO_PUSH_URL="https://your-domain.com/api/zero/push"
ZERO_REPLICA_FILE="/tmp/takeout_replica.db"

# Apple Push Notifications (APNs)
APNS_ENDPOINT="https://api.push.apple.com"
# APNS_TEAM_ID=your-team-id
# APNS_KEY_ID=your-key-id
# APNS_KEY=your-apns-key

# Cloudflare R2 / S3 Storage
CLOUDFLARE_R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key
CLOUDFLARE_R2_PUBLIC_URL="https://your-bucket.r2.cloudflarestorage.com"

# Email Service (Postmark)
POSTMARK_SERVER_TOKEN=your-postmark-server-token

# AWS Credentials (for deployment)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-west-1
