{
  "name": "takeout",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "files": [],
  "engines": {
    "node": "24.3.0",
    "npm": "10.8.3"
  },
  "packageManager": "bun@1.2.22",
  "workspaces": [
    "./packages/*"
  ],
  "scripts": {
    "preinstall": "bun ./scripts/preinstall.ts",
    "android": "one run:android",
    "aws": "tko aws",
    "backend:clean": "docker compose down --volumes --remove-orphans --rmi local; rm -rf ./.docker/*",
    "backend": "tko migrate build && docker compose up --remove-orphans",
    "build": "tko run build",
    "check:all": "tko check --all",
    "check": "tko check",
    "ci": "bun run:prod tko ci",
    "clean": "tko run clean",
    "db:migrate-add": "tko db add-migration",
    "db": "tko db",
    "dev-tunnel-if-exist": "bun tko dev-tunnel-if-exist",
    "dev-tunnel": "bun tko dev-tunnel",
    "dev": "tko run run watch dev-tunnel-if-exist one:dev",
    "eas": "tko eas",
    "env:dev": "NODE_ENV=development dotenvx run -f .env .env.development --",
    "env:pull": "tko run env-pull",
    "env:test": "NODE_ENV=test dotenvx run -f .env .env.development --",
    "env:update": "tko run env-update",
    "hot-update": "tko hot-update",
    "icon:add": "bun tko icon/add-phosphor",
    "ios": "one run:ios",
    "format:check": "oxfmt --check",
    "format": "oxfmt",
    "lint:fix": "oxfmt && oxlint --fix --fix-suggestions",
    "lint": "oxlint",
    "migrate": "tko migrate",
    "onboard": "tko onboard",
    "one:dev": "bun tko ensure-port 8081 --auto-kill Onejs:dev && bun run one dev",
    "postinstall": "bun run ./scripts/postinstall.ts",
    "prebuild:native": "one prebuild",
    "repl": "tko run repl",
    "run:dev": "bun env:dev bun",
    "run:prod": "NODE_ENV=production bun tko run exec-with-env production bun",
    "run:test": "bun env:test bun",
    "test:integration": "bun run env:dev bun --cwd=./src/test playwright test",
    "test:unit": "bun run:dev vitest run -c ./src/test/vitest.config.ts",
    "test": "tko run test:unit test:integration",
    "up-dep": "tko update-deps",
    "up": "tko upgrade",
    "watch:types": "tko run typecheck --watch",
    "watch:zero:generate": "bun zero:generate --watch",
    "watch": "tko run watch watch:types watch:zero:generate",
    "web": "tko web",
    "zero:generate": "over-zero generate --after 'bun lint:fix'",
    "zero": "tko zero"
  },
