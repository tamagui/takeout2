{
  "name": "@take-out/scripts",
  "version": "0.0.42",
  "type": "module",
  "main": "./src/run.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./helpers/*": {
      "types": "./src/helpers/*.ts",
      "default": "./src/helpers/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "lint": "oxlint src",
    "lint:fix": "oxfmt src && oxlint --fix --fix-suggestions src",
    "typecheck": "tko run typecheck"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@take-out/helpers": "workspace:*",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "vxrn": "*"
  }
}
