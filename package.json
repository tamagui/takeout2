    "@types/jsonwebtoken": "^9.0.10",
    "@vxrn/better-auth-utils": "workspace:*",
    "@vxrn/color-scheme": "^1.2.3",
    "@vxrn/helpers": "workspace:*",
    "@vxrn/hooks": "workspace:*",
    "@vxrn/postgres": "workspace:*",
    "@vxrn/scripts": "workspace:*",
    "@vxrn/takeout": "workspace:*",
    "async-retry": "^1.3.3",
    "better-auth": "^1.3.32",
    "better-auth-harmony": "^1.2.5",
    "burnt": "^0.12.2",
    "dequal": "^2.0.3",
    "drizzle-orm": "^0.40.0",
    "expo": "^54.0.22",
    "expo-blur": "~15.0.7",
