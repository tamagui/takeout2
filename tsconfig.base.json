{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@vxrn/better-auth-utils": ["./packages/better-auth-utils/src/index.ts"],
      "@vxrn/helpers": ["./packages/helpers/src/index.ts"],
      "@vxrn/hooks": ["./packages/hooks/src/index.ts"],
      "@vxrn/postgres": ["./packages/postgres/src/index.ts"],
      "@vxrn/scripts": ["./packages/scripts/src/index.ts"],
      "@vxrn/takeout": ["./packages/takeout/src/index.ts"]
    },
    "outDir": "dist",
    "importHelpers": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "downlevelIteration": true,
    "strict": true,
    "esModuleInterop": true,
    "inlineSourceMap": true,
    "preserveSymlinks": true,
    "jsx": "react-jsx",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "noEmitOnError": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "preserveConstEnums": true,
    "removeComments": false,
    "skipLibCheck": true,
    "sourceMap": false,
    "strictNullChecks": true,
    "target": "es2020",
    "types": ["vite/client", "node", "react"],
    "lib": ["dom", "esnext"]
  },
  "exclude": ["**/test", "**/dist", "**/types", "**/__tests__"],
  "typeAcquisition": {
    "enable": true
  }
}
