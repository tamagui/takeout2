{
  "name": "@take-out/database",
  "version": "0.6.18",
  "sideEffects": false,
  "source": "src/index.ts",
  "main": "dist/cjs",
  "module": "dist/esm",
  "type": "module",
  "types": "./src/index.ts",
  "bin": {
    "database": "./cli.cjs"
  },
  "files": [
    "src",
    "types",
    "dist",
    "cli.cjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tamagui-build --skip-native --skip-types",
    "test": "bun test",
    "watch": "tamagui-build --skip-native --skip-types --watch",
    "typecheck": "tko run typecheck",
    "lint": "oxlint src",
    "lint:fix": "oxfmt src && oxlint --fix --fix-suggestions src",
    "clean": "tamagui-build clean",
    "clean:build": "tamagui-build clean:build"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/esm/*.mjs",
      "require": "./dist/cjs/*.cjs"
    }
  },
  "dependencies": {
    "@take-out/helpers": "0.6.18",
    "@types/async-retry": "1.4.9",
    "async-retry": "^1.3.3",
    "citty": "^0.1.6"
  },
  "peerDependencies": {
    "better-auth": ">=1.6.0 <2",
    "drizzle-orm": "*",
    "pg": "^8.16.3"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tamagui/build": "2.3.1",
    "@types/node": "24.0.3",
    "drizzle-orm": "1.0.0-beta.9-e89174b",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.31.0"
  }
}
