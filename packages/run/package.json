{
  "name": "@take-out/run",
  "version": "0.1.50",
  "type": "module",
  "main": "./src/run.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/run.ts",
      "default": "./src/run.ts"
    },
    "./package.json": "./package.json",
    "./helpers/*": {
      "types": "./src/helpers/*.ts",
      "default": "./src/helpers/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "lint": "oxlint src",
    "lint:fix": "oxfmt src && oxlint --fix --fix-suggestions src",
    "typecheck": "tko run typecheck"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.3"
  }
}
