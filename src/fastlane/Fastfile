# fastlane configuration

default_platform(:ios)

platform :ios do
  desc "Register bundle ID"
  lane :register_bundle_id do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8"],
      is_key_content_base64: false
    )

    # Use Spaceship directly since produce requires username
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

    # Check if app ID exists
    app_id = Spaceship::ConnectAPI::BundleId.find("dev.tamagui.takeout", includes: nil)

    if app_id
      UI.success("Bundle ID dev.tamagui.takeout already exists!")
    else
      UI.error("Bundle ID dev.tamagui.takeout not found - please create it in Apple Developer Portal")
    end
  end

  desc "Setup certificates and profiles"
  lane :setup_certs do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8"],
      is_key_content_base64: false
    )
    
    match(
      type: "appstore",
      app_identifier: ["dev.tamagui.takeout"],
      team_id: "399WY8X9HY",
      git_url: ENV["APPLE_CODE_SIGNING_GIT_URL"] || "git@github.com:tamagui/takeout3.git",
      git_branch: "match"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8"],
      is_key_content_base64: false
    )
    
    setup_certs
    
    build_app(
      scheme: "takeout",
      export_method: "app-store"
    )
    
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
