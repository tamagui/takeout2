  "scripts": {
    "android": "one run:android",
    "aws": "tko aws",
    "backend:clean": "docker compose down; rm -rf ./.docker/*",
    "backend": "tko migrate build && docker compose up --remove-orphans",
    "bootstrap": "tko run bootstrap",
    "build": "tko run build",
    "check:all": "tko check --all",
    "check": "tko check",
    "ci": "bun run:prod tko ci",
    "clean": "tko run clean",
    "db:migrate-add": "tko db add-migration",
    "db": "tko db",
    "dev-tunnel-if-exist": "bun packages/scripts/src/dev-tunnel-if-exist.ts",
    "dev-tunnel": "bun packages/scripts/src/dev-tunnel.ts",
    "dev": "tko run run one:dev watch dev-tunnel-if-exist",
    "eas": "tko eas",
    "env:dev": "NODE_ENV=development dotenvx run -f .env .env.development --",
    "env:pull": "tko run env-pull",
    "env:test": "NODE_ENV=test dotenvx run -f .env .env.development --",
    "env:update": "tko run env-update",
    "hot-update": "tko hot-update",
    "icon:add": "bun tko icon/add-phosphor",
    "ios": "one run:ios",
    "lint:fix": "biome check --fix --unsafe",
    "lint": "biome check",
    "migrate": "tko migrate",
    "onboard": "tko onboard",
    "one:dev": "bun run one dev",
    "postinstall": "bun ./scripts/build-initial.ts && bun run bootstrap && bun run one patch",
    "prebuild:native": "one prebuild",
    "repl": "tko run repl",
    "run:dev": "bun env:dev bun",
    "run:prod": "NODE_ENV=production bun tko run exec-with-env production bun",
    "run:test": "bun env:test bun",
    "test:integration": "bun run env:dev bun --cwd=./src/test playwright test",
    "test:unit": "bun run:dev vitest run -c ./src/test/vitest.config.ts",
    "test": "tko run test:unit test:integration",
    "up-dep": "tko update-deps",
    "up": "tko upgrade",
    "watch:types": "tko run typecheck --watch",
    "watch:zero:generate": "over-zero generate --watch --after 'bun lint:fix'",
    "watch": "tko run watch watch:types watch:zero:generate",
    "web": "tko web",
    "zero": "tko zero"
  },
