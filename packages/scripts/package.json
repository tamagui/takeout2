{
  "name": "@take-out/scripts",
  "version": "0.0.28",
  "type": "module",
  "main": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./helpers/*": {
      "types": "./src/helpers/*.ts",
      "default": "./src/helpers/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "typecheck": "TSGO=1 tko run typecheck"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@take-out/helpers": "workspace:*"
  },
  "devDependencies": {
    "vxrn": "*"
  }
}
