{
  "name": "takeout-native",
  "version": "0.1.0",
  "description": "One-line native integration setup for One apps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ai/contract": "./src/ai/contract.ts",
    "./ai/server": "./src/ai/server.ts",
    "./feedback": "./src/feedback/index.ts",
    "./feedback/contract": "./src/feedback/contract.ts",
    "./feedback/overlay": "./src/feedback/overlay.ts",
    "./feedback/server": "./src/feedback/server.ts",
