{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "~/*": ["./src/*"],
      "@take-out/better-auth-utils": ["./packages/better-auth-utils/src/index.ts"],
      "@take-out/helpers": ["./packages/helpers/src/index.ts"],
      "@take-out/hooks": ["./packages/hooks/src/index.ts"],
      "@take-out/postgres": ["./packages/postgres/src/index.ts"],
      "@take-out/scripts": ["./packages/scripts/src/index.ts"],
      "@take-out/takeout": ["./packages/takeout/src/index.ts"]
    },
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    // blocked by expo-modules-core
    // "erasableSyntaxOnly": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noUncheckedIndexedAccess": true,
    "preserveConstEnums": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "types": ["node", "react", "vite/client", "bun"],
    "lib": ["dom", "esnext"]
  },
  "include": ["./src", "./scripts", "./app", "./sst-env.d.ts", "./packages"],
  "typeAcquisition": {
    "enable": true
  }
}
