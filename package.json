  "scripts": {
    "dev": "bun env.ts -- one dev",
    "build": "NODE_OPTIONS=--import=orez-lite/cloudflare/node-wasm-loader one build",
    "generate": "bun run generate:migrations && bun run generate:types",
    "generate:types": "on-zero generate data",
    "generate:migrations": "drizzle-kit generate --config=database/drizzle.config.ts",
    "typecheck": "tsc --noEmit"
  },
