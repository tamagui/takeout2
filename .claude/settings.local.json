{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun tko:*)",
      "Bash(bun lint:fix:*)",
      "Bash(bun run build)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(npx tsc:*)",
      "Bash(echo:*)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cat docs/agent.md"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun tko"
          }
        ]
      }
    ]
  }
}
