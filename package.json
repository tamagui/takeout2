{
  "name": "takeout",
  "version": "0.0.0",
  "private": true,
  "resolutions": {
    "sharp": "npm:@tamagui/proxy-worm@1.123.14"
  },
  "sideEffects": false,
  "type": "module",
  "main": "node_modules/one/metro-entry.js",
  "files": [],
  "engines": {
    "node": "^24.3.0"
  },
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "./packages/*"
  ],
  "scripts": {
    "preinstall": "bun ./scripts/preinstall.ts",
    "postinstall": "bun run ./scripts/postinstall.ts",
    "android:prebuild": "bun native:prebuild --platform android --no-install",
    "android": "one run:android",
    "aws": "tko aws",
    "backend:clean": "docker compose down --volumes --remove-orphans --rmi local",
    "backend:migrate": "ALLOW_MISSING_ENV=1 bun run:dev src/database/migrate.ts",
    "backend": "docker compose up -d pgdb --remove-orphans --wait && bun backend:migrate && docker compose up --remove-orphans",
    "build": "tko run build",
    "check": "tko check --default-all",
    "ops": "bun run:prod tko ops",
    "clean": "tko run clean",
    "db:add-migration": "tko db add-migration",
    "db:build": "tko db build",
    "db:migrate": "tko db migrate",
    "db": "tko db",
    "dev": "tko run-all --pty --flags=last watch watch:types watch:zero:generate one:dev",
    "dev:fresh": "bun backend:clean; bun dev --clean",
    "eas": "tko eas",
    "env": "bun src/env.ts --",
    "env:dev": "NODE_ENV=development bun env",
    "env:prod": "NODE_ENV=production bun env",
    "env:pull": "tko run env-pull",
    "env:update": "tko run env-update",
    "format:check": "oxfmt --check",
    "format": "oxfmt",
    "hot-update": "tko hot-update",
    "icon:add": "bun tko icon add-phosphor",
    "ios:prebuild": "bun native:prebuild --platform ios --no-install",
    "ios": "one run:ios",
    "fix": "bun lint:fix",
    "lint:fix": "oxfmt && oxlint --import-plugin --type-aware --fix --fix-suggestions",
    "lint": "oxlint --import-plugin --type-aware",
    "lite:backend": "bun run:dev orez --disable-wasm-sqlite --data-dir=${OREZ_DATA_DIR:-.orez} --pg-port=${VITE_PORT_POSTGRES:-5433} --zero-port=${VITE_PORT_ZERO:-4848} --s3 --s3-port=${VITE_PORT_MINIO:-9200} --on-db-ready='bun db:migrate' --admin",
    "lite:backend:demo": "bun run:dev orez --disable-wasm-sqlite --data-dir=${OREZ_DATA_DIR:-.orez} --pg-port=${VITE_PORT_POSTGRES:-5433} --zero-port=${VITE_PORT_ZERO:-4848} --s3 --s3-port=${VITE_PORT_MINIO:-9200} --on-db-ready='bun db:migrate && bun scripts/db/seed-demo.ts' --admin",
    "lite": "bun tko run build && SKIP_INITIAL_BUILD=1 bun run:dev tko run-all --pty --flags=last lite:backend watch watch:types watch:zero:generate one:dev",
    "lite:demo": "bun tko run build && SKIP_INITIAL_BUILD=1 bun run:dev tko run-all --pty --flags=last lite:backend:demo watch watch:types watch:zero:generate one:dev",
    "native:prebuild": "one prebuild",
    "onboard": "tko onboard",
    "one:dev": "bun ./scripts/one-dev.ts",
    "repl": "tko run repl",
    "run:env": "bun env bun run",
    "run:dev": "NODE_ENV=development bun env:dev bun run",
    "run:prod": "NODE_ENV=production bun env:prod bun run",
    "test:integration": "bun run env:dev bun --cwd=./src/test playwright test",
    "test:unit": "bun run:dev vitest run -c ./src/test/vitest.config.ts",
    "test": "tko test",
    "up": "tko up",
    "watch:types": "tko run typecheck --watch",
    "watch:zero:generate": "bun zero:generate --watch",
    "web": "tko web",
    "zero:generate": "bun zero:schema && on-zero generate --after 'oxfmt src/data/generated'",
    "zero:schema": "drizzle-zero generate --config src/database/drizzle-zero.config.ts --output src/data/generated/schema.ts --force --suppress-defaults-warning",
    "zero": "tko zero"
  },
