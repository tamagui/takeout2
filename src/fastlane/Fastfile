# fastlane configuration

default_platform(:ios)

platform :ios do
  desc "Check bundle ID and app record"
  lane :check_app do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8"],
      is_key_content_base64: false
    )

    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

    # check bundle id
    bundle_id = Spaceship::ConnectAPI::BundleId.find("dev.tamagui.takeout", includes: nil)
    if bundle_id
      UI.success("Bundle ID dev.tamagui.takeout exists")
    else
      UI.error("Bundle ID dev.tamagui.takeout not found")
    end

    # check app record
    app = Spaceship::ConnectAPI::App.find("dev.tamagui.takeout")
    if app
      UI.success("App record exists: #{app.name} (#{app.bundle_id})")
    else
      UI.message("App record not found in App Store Connect - will be created on first upload")
    end
  end

  desc "Setup certificates and profiles"
  lane :setup_certs do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8"],
      is_key_content_base64: false
    )

    match(
      type: "appstore",
      app_identifier: ["dev.tamagui.takeout"],
      team_id: "399WY8X9HY",
      git_url: ENV["APPLE_CODE_SIGNING_GIT_URL"] || "git@github.com:tamagui/takeout3.git",
      git_branch: "match",
      readonly: true
    )
  end

  desc "Import provisioning profile to match"
  lane :import_profile do
    match(
      type: "appstore",
      app_identifier: ["dev.tamagui.takeout"],
      team_id: "399WY8X9HY",
      git_url: ENV["APPLE_CODE_SIGNING_GIT_URL"] || "git@github.com:tamagui/takeout3.git",
      git_branch: "match",
      skip_certificate_matching: true
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8"],
      is_key_content_base64: false
    )
    
    setup_certs
    
    build_app(
      scheme: "takeout",
      export_method: "app-store"
    )
    
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
