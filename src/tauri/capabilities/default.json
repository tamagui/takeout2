{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["*"],
  "webviews": ["main"],
  "remote": {
    "urls": ["http://localhost:8081", "https://*"]
  },
  "permissions": [
    "updater:default",
    "core:default",
    "core:window:allow-create",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:default",
    "deep-link:allow-get-current",
    "deep-link:allow-is-registered",
    "deep-link:allow-register",
    "deep-link:allow-unregister",
    "deep-link:default",
    "fs:allow-app-meta-recursive",
    "fs:allow-app-meta",
    "fs:allow-app-read-recursive",
    "fs:allow-app-read",
    "fs:allow-appcache-meta-recursive",
    "fs:allow-appcache-meta",
    "fs:allow-appcache-read-recursive",
    "fs:allow-appcache-read",
    "fs:allow-appconfig-meta-recursive",
    "fs:allow-appconfig-meta",
    "fs:allow-appdata-meta-recursive",
    "fs:allow-appdata-meta",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-read",
    "fs:allow-data-meta",
    "fs:allow-data-read-recursive",
    "fs:allow-data-read",
    "fs:allow-read",
    "fs:allow-write-text-file",
    "dialog:allow-save",
    "dialog:default",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "shell:allow-spawn",
    "shell:allow-execute",
    "shell:allow-kill",
    "shell:allow-open",
    "shell:allow-stdin-write",
    "process:default",

    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/sidecar",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-stdin-write",
      "allow": [
        {
          "name": "binaries/sidecar",
          "sidecar": true
        }
      ]
    }
  ]
}
