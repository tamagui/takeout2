{
  "name": "@take-out/better-auth-utils",
  "version": "0.0.51",
  "description": "Better auth utilities and client for React/React Native applications",
  "sideEffects": false,
  "type": "module",
  "source": "src/index.ts",
  "main": "dist/cjs",
  "module": "dist/esm",
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "scripts": {
    "build": "tamagui-build",
    "watch": "SKIP_INITIAL_BUILD=1 tamagui-build --watch",
    "lint": "oxlint src",
    "lint:fix": "oxfmt src && oxlint --fix --fix-suggestions src",
    "clean": "tamagui-build clean",
    "clean:build": "tamagui-build clean:build"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "react-native": {
        "import": "./dist/esm/index.native.js",
        "require": "./dist/cjs/index.native.js"
      },
      "types": "./types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    },
    "./client": {
      "react-native": {
        "import": "./dist/esm/client.native.js",
        "require": "./dist/cjs/client.native.js"
      },
      "types": "./types/client.d.ts",
      "import": "./dist/esm/client.mjs",
      "require": "./dist/cjs/client.cjs",
      "default": "./dist/esm/client.mjs"
    }
  },
  "dependencies": {
    "@take-out/helpers": "workspace:*",
    "better-auth": "^1.3.28"
  },
  "peerDependencies": {
    "react": "*"
  },
  "devDependencies": {
    "@tamagui/build": "^2.0.0-1769196495649",
    "@types/node": "24.0.3",
    "@types/react": "^19.0.8",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.31.0",
    "react": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
