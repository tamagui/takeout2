{
  "name": "@take-out/scripts",
  "version": "0.0.77",
  "type": "module",
  "main": "./src/run.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/run.ts",
      "default": "./src/run.ts"
    },
    "./package.json": "./package.json",
    "./helpers/*": {
      "types": "./src/helpers/*.ts",
      "default": "./src/helpers/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "lint": "oxlint src",
    "lint:fix": "oxfmt src && oxlint --fix --fix-suggestions src",
    "typecheck": "tko run typecheck"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@take-out/helpers": "workspace:*"
  },
  "peerDependencies": {
    "vxrn": "*"
  },
  "peerDependenciesMeta": {
    "vxrn": {
      "optional": true
    }
  },
  "devDependencies": {
    "vxrn": "1.4.10-1770207233041"
  }
}
