{
  "name": "@take-out/scripts",
  "version": "0.7.7",
  "type": "module",
  "main": "./src/cmd.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/cmd.ts",
      "default": "./src/cmd.ts"
    },
    "./package.json": "./package.json",
    "./helpers/*": {
      "types": "./src/helpers/*.ts",
      "default": "./src/helpers/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "lint": "oxlint src",
    "lint:fix": "oxfmt src && oxlint --fix --fix-suggestions src",
    "typecheck": "tko run typecheck"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "@take-out/helpers": "0.7.7",
    "@take-out/run": "0.7.7",
    "picocolors": "^1.1.1"
  }
}
