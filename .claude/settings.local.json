{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bunx remotion studio:*)",
      "Bash(npx tsc:*)",
      "Bash(bunx remotion add:*)",
      "Bash(bun add:*)",
      "WebFetch(domain:onestack.dev)",
      "Bash(npx remotion studio:*)",
      "Bash(gh api:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.remotion.dev)",
      "Bash(npm install:*)",
      "Bash(npm run studio:*)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cat docs/agent.md"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun tko"
          }
        ]
      }
    ]
  }
}
