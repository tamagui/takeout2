{
  "name": "takeout",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24.16.0"
  },
  "type": "module",
  "targets": [
    "native",
    "web"
  ],
  "contrast": {
    "entry": [
      {
        "id": "web-landing",
        "platforms": [
          "web"
        ],
        "entryState": "fresh",
        "route": "/",
        "files": [
          "interface/marketing/TakeoutWebsite.tsx",
          "interface/marketing/HeroSection.tsx",
          "interface/marketing/SiteHeader.tsx"
        ],
        "appearanceModes": [
          "light",
          "dark"
        ]
      },
      {
        "id": "web-login",
        "platforms": [
          "web"
        ],
        "entryState": "fresh",
        "route": "/auth/login",
        "files": [
          "features/auth/ui/LoginScreen.tsx"
        ],
        "appearanceModes": [
          "light",
          "dark"
        ],
        "advanceSteps": [
          {
            "action": "tap-id",
            "value": "login-as-demo"
          }
        ]
      },
      {
        "id": "native-login",
        "platforms": [
          "native"
        ],
        "entryState": "fresh",
        "route": "/auth/login",
        "files": [
          "features/auth/ui/LoginScreen.tsx"
        ],
        "appearanceModes": [
          "light",
          "dark"
        ],
        "advanceSteps": [
          {
            "action": "tap-id",
            "value": "login-as-demo"
          }
        ]
      }
    ],
    "runtime": {
      "endpoints": [
        {
          "role": "web",
          "port": 4200,
          "health": "/",
          "offset": true
        },
        {
          "role": "metro",
          "port": 4200,
          "health": "/status",
          "offset": true
        },
        {
          "role": "backend",
          "port": 5049,
          "offset": true
        }
      ]
    }
  },
  "scripts": {
    "dev": "bun env.ts -- one dev",
    "build": "NODE_OPTIONS=--import=orez-lite/cloudflare/node-wasm-loader one build",
    "generate": "bun run generate:migrations && bun run generate:types",
    "generate:types": "on-zero generate data",
    "generate:migrations": "drizzle-kit generate --config=database/drizzle.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/core": "1.6.30",
    "@better-auth/expo": "1.6.30",
    "@callstack/liquid-glass": "^0.8.2",
    "@react-native/assets-registry": "0.87.1",
    "@react-navigation/bottom-tabs": "8.0.0-alpha.50",
    "@react-navigation/core": "8.0.0-alpha.34",
    "@react-navigation/elements": "3.0.0-alpha.48",
    "@react-navigation/native": "8.0.0-alpha.44",
    "@react-navigation/native-stack": "8.0.0-alpha.52",
    "@react-three/fiber": "^9.7.0",
    "@rocicorp/zero": "1.9.0",
    "@o/database": "0.16.19-canary.1790679335417",
    "@o/env": "0.16.19-canary.1790679335417",
    "@o/helpers": "0.16.19-canary.1790679335417",
    "@tamagui/animations-css": "3.0.0-beta.1473.1",
    "@tamagui/animations-reanimated": "3.0.0-beta.1473.1",
    "@tamagui/config": "3.0.0-beta.1473.1",
    "@tamagui/native": "3.0.0-beta.1473.1",
    "@tamagui/toast": "3.0.0-beta.1473.1",
    "better-auth": "1.6.30",
    "contrast-better-auth": "file:packages/contrast-better-auth",
    "contrast-mdx": "file:packages/contrast-mdx",
    "contrast-native": "file:packages/contrast-native",
    "contrast-notifications": "file:packages/contrast-notifications",
    "contrast-ui": "file:packages/contrast-ui",
    "drizzle-orm": "1.0.0-beta.9-e89174b",
    "drizzle-zero-sqlite": "0.16.19-canary.1790679335417",
    "maplibre-gl": "^5.24.0",
    "markdown-to-jsx": "^9.10.2",
    "on-zero": "0.16.19-canary.1790679335417",
    "one": "2.0.0-beta.145.1",
    "orez-lite": "0.16.19-canary.1790679335417",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.5",
    "react-native-mmkv": "^3.3.0",
    "react-native-purchases": "10.4.3",
    "react-native-reanimated": "4.6.0",
    "react-native-screens": "4.27.0",
    "react-native-svg": "15.15.4",
    "react-native-teleport": "^1.2.2",
    "react-native-webgpu": "0.10.2",
    "react-native-worklets": "0.12.2",
    "s3mini": "^0.9.5",
    "server-only": "^0.0.1",
    "peach-swipeable": "file:packages/peach-swipeable",
    "tamagui": "3.0.0-beta.1473.1",
    "three": "0.184.0",
    "typegpu": "0.11.8",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native-community/cli": "20.0.2",
    "@react-native-community/template": "0.87.2",
    "@react-native/metro-config": "0.87.1",
    "@tamagui/vite-plugin": "3.0.0-beta.1473.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.5.0",
    "@types/three": "0.184.0",
    "@webgpu/types": "^0.1.21",
    "drizzle-kit": "1.0.0-beta.9-e89174b",
    "peachsim": "0.1.628",
    "typescript": "7.0.2",
    "vite": "^8.2.2"
  },
  "trustedDependencies": [
    "@rocicorp/zero-sqlite3",
    "@swc/core"
  ],
  "patchedDependencies": {
    "@react-navigation/bottom-tabs@8.0.0-alpha.50": "patches/@react-navigation%2Fbottom-tabs@8.0.0-alpha.50.patch",
    "react-native-screens@4.27.0": "patches/react-native-screens@4.27.0.patch",
    "react-native-reanimated@4.6.0": "patches/react-native-reanimated@4.6.0.patch",
    "@react-navigation/native-stack@8.0.0-alpha.52": "patches/@react-navigation%2Fnative-stack@8.0.0-alpha.52.patch",
    "react-native-keyboard-controller@1.22.5": "patches/react-native-keyboard-controller@1.22.5.patch",
    "react-native-webgpu@0.10.2": "patches/react-native-webgpu@0.10.2.patch"
  }
}
