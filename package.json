{
  "name": "takeout",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "files": [],
  "engines": {
    "node": "24.3.0",
    "npm": "10.8.3"
  },
  "packageManager": "bun@1.2.23",
  "workspaces": [
    "./packages/*"
  ],
  "scripts": {
    "release": "bun ./scripts/release.ts",
    "onboard": "takeout onboard",
    "android": "one run:android",
    "app:get-version": "node -e \"console.log(require('expo/config').getConfig(process.cwd()).exp.version)\"",
    "auth:migrate": "bunx @better-auth/cli migrate --config ./src/features/auth/server/auth.ts",
    "aws:clear-logs": "takeout script run aws/configure-aws-prod --clear-logs",
    "aws:configure": "takeout script run aws/configure-aws-prod",
    "aws:monitor": "takeout script run aws/monitor-ecs-health",
    "aws:user:add": "takeout script run aws/user-management add",
    "aws:user:list": "takeout script run aws/user-management list",
    "aws:user:remove": "takeout script run aws/user-management remove",
    "backend:clean": "docker compose down; rm -rf ./.docker/*",
    "backend": "bun migrate:build && docker compose up --remove-orphans",
    "bootstrap": "bun one:patch && bun build:js",
    "build:js": "bun --bun run build --no-cache --force",
    "build:sidecar": "bun ./src/tauri/scripts/build-sidecar.ts",
    "build:watch": "takeout script run run --no-root watch",
    "build": "takeout script run run build",
    "check": "takeout script run run lint types:check dependencies:check",
    "ci:backend:resume": "DEBUG_BACKEND=1 SKIP_BACKEND_CLEAN=1 bun ci:backend",
    "ci:backend": "RUN=backend ./scripts/ci/ci-run.ts",
    "ci:check": "takeout script run ci/check-deployment --verbose",
    "ci:frontend-dev": "RUN=frontend-dev ./scripts/ci/ci-run.ts",
    "ci:frontend-prod": "RUN=frontend-prod ./scripts/ci/ci-run.ts",
    "ci:start-dev": "bun ci:backend & bun ci:frontend-dev",
    "ci:start-prod": "bun ci:backend & bun ci:frontend-prod",
    "ci:tail": "takeout script run ci-tail",
    "ci": "CI=true NODE_ENV=production ./scripts/ci/ci.ts",
    "clean": "takeout script run clean",
    "db:drizzle-kit": "drizzle-kit --config=./src/database/drizzle.config.ts",
    "db:generate": "bun db:drizzle-kit generate && bun db sync-drizzle",
    "db:migrate:add": "bun db migrate:add",
    "db:psql:dev": "bun run:dev bun db psql",
    "db": "bun postgres",
    "dependencies:check": "takeout script run check-circular-deps --ignore MarkdownSandboxQuery,afterCreateUser.ts,server.ts",
    "dev:prod": "takeout script run run one:dev:prod watch",
    "dev:tunnel-if-exist": "takeout script run dev-tunnel-if-exist",
    "dev:tunnel": "takeout script run dev-tunnel",
    "dev": "takeout script run run --watch one:dev watch dev:tunnel-if-exist",
    "deploy-hot-update": "bun deploy-hot-update:ios && bun deploy-hot-update:android",
    "deploy-hot-update:ios": "METRO_RESET_CACHE=true bunx hot-updater deploy --platform ios --channel production-pre --target:app-version \"$(bun get:app-version)\"",
    "deploy-hot-update:android": "METRO_RESET_CACHE=true bunx hot-updater deploy --platform android --channel production-pre --target:app-version \"$(bun get:app-version)\"",
    "eas:build:dev:android": "eas build --profile development --platform android",
    "eas:build:dev:ios": "eas build --profile development --platform ios",
    "eas:build:dev": "eas build --profile development --platform all",
    "eas:build:preview": "eas build --profile preview --platform all",
    "eas:build:prod": "eas build --profile production --platform all",
    "env:pull": "takeout script run env-pull",
    "env:update": "takeout script run env-update",
    "ios": "one run:ios",
    "lint:fix": "biome check --fix --unsafe",
    "lint": "biome check",
    "migrate:build": "bun db:generate && cd src/database && bun vite build",
    "migrate:production": "bun run migrate:build && RUN=1 bun run:prod ./src/database/migrate-dist.js",
    "migrate:run": "RUN=1 bun run:dev ./src/database/migrate-dist.js",
    "migrate": "bun migrate:build && bun migrate:run",
    "one:dev:prod": "bun run ./scripts/cleanup-dev.ts && USE_LOCAL_SERVER=1 bun run:prod one dev --loadEnv false",
    "one:dev": "bun run ./scripts/cleanup-dev.ts && bun run one dev",
    "one:patch": "one patch",
    "postinstall": "takeout script run node-version-check && bun run one:patch",
    "prebuild:native": "one prebuild",
    "prepare": "takeout script run bootstrap",
    "prod": "bun web:dev-prod",
    "repl": "takeout script run repl",
    "run:dev": "NODE_ENV=development dotenvx run -f .env .env.development -- bun",
    "run:prod-live": "REMOTE=WebApp bun run:prod",
    "run:prod": "NODE_ENV=production bun takeout script run exec-with-env production bun",
    "sst:deploy:production": "bun run:prod sst deploy --stage production",
    "sst:ensure-tunnel": "takeout script run ensure-tunnel",
    "sst:env:get": "takeout script run sst-get-environment",
    "sst:login": "aws sso login --sso-session=tamagui",
    "sst:node:production": "bun sst:shell:production bun takeout script run node",
    "sst:pg_dump:production": "bun sst:shell:production -- ./src/database/scripts/pg_dump.ts",
    "sst:psql:production": "bun sst:shell:production ./src/database/scripts/psql.ts",
    "sst:refresh:production": "sst refresh --stage production",
    "sst:shell:production": "sst shell --stage=production",
    "sst:tunnel:production": "sst tunnel --stage=production",
    "sst:unlock:production": "sst unlock --stage production",
    "tauri:build-and-release": "bun run tauri:build && bun run tauri:upload-release",
    "tauri:build:dev": "DEV=1 bun tauri:build:prod",
    "tauri:build:prod": "bun ./src/tauri/scripts/build-tauri.ts",
    "tauri:build": "bun run tauri:build:prod && bun run tauri:build:dev",
    "tauri:dev": "tauri dev --config src/tauri/tauri.conf.json",
    "tauri:upload-release": "bun ./src/tauri/scripts/upload-release.ts",
    "test:unit": "bun run:dev vitest run -c ./src/test/vitest.config.ts",
    "test:integration": "bun run:dev playwright test -c ./src/test/playwright.config.ts",
    "test": "takeout script run run test:unit test:integration",
    "types:check": "TSGO=1 takeout script run typescript",
    "types:watch": "bun types:check --watch",
    "unfurl": "takeout script run unfurl",
    "up": "takeout script run update-deps",
    "upgrade:better-auth": "bun up better-auth '@better-auth/*'",
    "upgrade:one": "bun up 'one' '@vxrn/*' 'over-zero'",
    "upgrade:tamagui": "bun up tamagui '@tamagui/*'",
    "upgrade:tauri": "./src/tauri/scripts/upgrade-tauri.ts",
    "upgrade:zero": "bun up @rocicorp/zero",
    "watch": "takeout script run run types:watch zero:generate:watch",
    "web:build-docker": "docker buildx build --platform linux/arm64",
    "web:build": "bun run:prod one build --platform=web",
    "web:prod": "bun run:prod web:build && bun run:prod web:serve",
    "web:serve:dev": "bun run:dev web:serve",
    "web:serve": "one serve --port 8081",
    "zero:dev": "bun run:dev zero-cache",
    "zero:generate:watch": "bun zero:generate --watch",
    "zero:generate": "bun over-zero generate --after 'bun lint:fix'",
    "zero": "zero-cache"
  },
  "resolutions": {
    "pg": "8.16.3",
    "motion": "12.23.22",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@babel/core": "7.28.5",
    "@babel/parser": "7.28.5",
    "@babel/transform": "7.28.5",
    "sharp": "npm:@tamagui/proxy-worm@1.123.14",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-worklets": "0.5.1",
    "expo-linking": "~8.0.8",
    "expo-constants": "~18.0.10",
    "@expo/fingerprint": "0.15.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-liquid-glass-view"
        ]
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.709.0",
    "@aws-sdk/lib-storage": "^3.709.0",
    "@better-auth/expo": "^1.3.32",
    "@better-fetch/fetch": "^1.1.18",
    "@bottom-tabs/react-navigation": "^1.0.2",
    "@expo/ui": "~0.2.0-beta.7",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@hot-updater/bare": "^0.21.4",
    "@hot-updater/react-native": "^0.21.4",
    "@hot-updater/supabase": "^0.21.4",
    "@legendapp/list": "^1.1.4",
    "@nandorojo/galeria": "^1.2.0",
    "@op-engineering/op-sqlite": "^15.0.7",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native-menu/menu": "^2.0.0",
    "@rocicorp/zero": "0.24.2025101500",
    "@shopify/react-native-skia": "2.2.12",
    "@tamagui/animations-moti": "1.136.1",
