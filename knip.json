{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "rules": {
    "files": "off",
    "exports": "off",
    "types": "off",
    "duplicates": "off",
    "optionalPeerDependencies": "off",
    "binaries": "off",
    "unresolved": "off",
    "unlisted": "off"
  },
  "workspaces": {
    ".": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "src/**/*.{ts,tsx}",
        "scripts/**/*.ts",
        "*.config.ts"
      ],
      "ignore": ["src/data/generated/**", "**/*.d.ts"],
      "ignoreDependencies": [
        "@types/*",
        "@lydell/node-pty-darwin-arm64",
        "@vxrn/compiler",
        "@vxrn/resolve",
        "@vxrn/tslib-lite",
        "@vxrn/use-isomorphic-layout-effect",
        "@vxrn/vite-plugin-metro",
        "jsonwebtoken",
        "motion",
        "postmark",
        "react-native-launch-arguments",
        "chrome-devtools-mcp",
        "xcodebuildmcp"
      ]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["bun-types"]
    },
    "packages/helpers": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/hooks": {
      "project": ["src/**/*.ts"]
    },
    "packages/postgres": {
      "project": ["src/**/*.ts"]
    },
    "packages/better-auth-utils": {
      "project": ["src/**/*.ts"]
    },
    "packages/on-zero": {
      "entry": ["src/index.ts", "src/cli.ts", "src/server.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/native-hot-update": {
      "project": ["src/**/*.ts"]
    },
    "packages/run": {
      "entry": ["src/*.{ts,mjs}"],
      "project": ["src/**/*.{ts,mjs}"]
    },
    "packages/scripts": {
      "entry": ["src/*.ts", "src/helpers/*.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["src/build-initial.ts"]
    }
  },
  "ignoreWorkspaces": ["packages/docs"]
}
